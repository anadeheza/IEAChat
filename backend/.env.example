APP_NAME="Flock Backup"
PORT=3000

DATABASE_URL="file:./storage/flock_archive.db"

# Allowed origins for frontend access (separate with commas)
# Example: http://localhost:5500,https://tu-frontend.vercel.app
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://iea-chat.vercel.app

# SMTP / email settings
# Para pruebas locales con MailHog:
# Para pruebas locales con MailHog:
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_SECURE=false
# MAIL_IGNORE_TLS=true
# MAIL_TLS_REJECT_UNAUTHORIZED=false
# MAIL_FROM="Flock App <no-reply@flock.local>"
#
# Para pruebas con todos los correos en tu casilla de prueba:
# MAIL_OVERRIDE_RECIPIENT=mi@correo.com
#
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@email.com
MAIL_PASS=your-smtp-password
MAIL_FROM="Flock App <no-reply@example.com>"
MAIL_IGNORE_TLS=false
MAIL_TLS_REJECT_UNAUTHORIZED=true